RECONSTRUCTION_MODE=colmap
QUEUE_MODE=thread
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=matias-3d
QUEUE_JOB_TIMEOUT_SECONDS=43200

# Criar com IA — motores locais gratuitos
LOCAL_AI_RUNTIME=wsl
LOCAL_AI_WSL_DISTRO=MatiasAI
LOCAL_AI_MODEL_CACHE=./tools/local-ai-models

# Digitalização real — reservada para a fase seguinte
MESHROOM_ROOT=./tools/Meshroom-2025.1.0
MESHROOM_PIPELINE=360
COLMAP_ROOT=./tools/COLMAP-4.0.1
OPENMVS_ROOT=./tools/OpenMVS-2.4

# Compatibilidade com versões antigas; já não é o motor principal
HUNYUAN_ROOT=./tools/Hunyuan3D-2
HUNYUAN_PYTHON=./tools/hunyuan-env/python.exe
HUNYUAN_MODEL_CACHE=./tools/hunyuan-models

SEGMENTATION_MODEL=isnet-general-use
ENABLE_OBJECT_SEGMENTATION=true
ENABLE_AI_TEXTURING=true
RECONSTRUCTION_TIMEOUT_HOURS=8
DATABASE_URL=sqlite:///./backend/studio.db
STORAGE_ROOT=./backend/storage
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
MAX_IMAGES=120
MAX_IMAGE_MB=25
MAX_IMAGE_PIXELS=80000000
MOCK_STAGE_SECONDS=1.5
